{% extends '@NowoPasswordStrengthBundle/Form/password_strength_theme_foundation5.html.twig' %}

{% block password_strength_feedback %}
<ul class="no-bullet password-strength-requirements" data-password-strength-feedback aria-live="polite">
    {% for req in requirements %}
        <li class="password-strength-requirement password-strength-requirement--{{ req.met ? 'met' : 'unmet' }} {{ req.met ? 'success' : 'alert' }}" data-requirement-id="{{ req.id }}">
            {{ req.labelKey|trans(req.required is defined and req.required ? {'%count%': req.required} : {}, trans_domain) }}
        </li>
    {% endfor %}
</ul>
{% endblock %}
