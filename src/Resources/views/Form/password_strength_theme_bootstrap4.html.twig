{% extends '@PasswordStrengthBundle/Form/password_strength_theme.html.twig' %}

{% block password_strength_feedback %}
<ul class="list-unstyled password-strength-requirements mb-0" data-password-strength-feedback aria-live="polite">
    {% for req in requirements %}
        <li class="password-strength-requirement password-strength-requirement--{{ req.met ? 'met' : 'unmet' }} {{ req.met ? 'text-success' : 'text-danger' }}" data-requirement-id="{{ req.id }}">
            {{ req.labelKey|trans(req.required is defined and req.required ? {'%count%': req.required} : {}, trans_domain) }}
        </li>
    {% endfor %}
</ul>
{% endblock %}
