{
  "name": "@nowo-tech/password-strength-bundle",
  "version": "1.0.0",
  "description": "Assets build for Password Strength Bundle (TypeScript)",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "vite build && cp src/Resources/assets/css/password-strength.css src/Resources/public/password-strength.css",
    "dev": "vite build --watch",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.12",
    "happy-dom": "^21.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "author": "Héctor Franco Aceituno <hectorfranco@nowo.tech>",
  "license": "MIT"
}
