parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
    bootstrapFiles:
        - vendor/autoload.php
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false
    # REQ-CS-006: keep ignoreErrors empty — fix findings instead of silencing
    ignoreErrors: []

includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  # Worker-strict includes worker rules + request-superglobal hygiene (reset_kernel=false).
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker-strict.neon
