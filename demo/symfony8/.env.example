# Host port published by docker-compose (see REQ-DEMO-005).
PORT=8021

###> symfony/framework-bundle ###
# APP_ENV: Symfony environment. Use `dev` for Web Profiler and Caddyfile.dev (no worker).
APP_ENV=dev
# APP_DEBUG: 1 in demos for toolbar and verbose errors.
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker
# APP_SECRET: change in real deployments; demo-only value below.
APP_SECRET=change_this_secret_key_to_a_random_value
###< symfony/framework-bundle ###

###> symfony/routing ###
# DEFAULT_URI: used by Symfony CLI and some generators (not used for make up URL message).
DEFAULT_URI=http://localhost:8021
###< symfony/routing ###
