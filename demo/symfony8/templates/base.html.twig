{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). The toggle stylesheet is the PasswordToggleBundle's own asset. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}{{ 'demo.title'|trans({}, 'messages') }}{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {# PasswordToggleBundle: eye icon show/hide is driven by this stylesheet (without it both icons show). #}
    <link href="{{ asset('css/toggle_password.css', 'nowo_password_toggle') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
{% endblock %}

{% block nowo_ui_navigation %}
    {% set _locale = app.request.locale|default('en') %}
    {% set _current_route = app.request.attributes.get('_route') ?? 'demo_home' %}
    {% set _locale_route = _current_route == 'demo_root' ? 'demo_home' : _current_route %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home', { _locale: _locale }) }}">{{ 'demo.title'|trans({}, 'messages') }}</a>
        <nav class="nowo-ui-menu" aria-label="{{ 'demo.title'|trans({}, 'messages') }}">
            <a class="nowo-ui-link" href="{{ path('demo_home', { _locale: _locale }) }}"{% if _current_route == 'demo_home' %} aria-current="page"{% endif %}>{{ 'demo.menu_home'|trans({}, 'messages') }}</a>
            <a class="nowo-ui-link" href="{{ path('demo_level', { _locale: _locale }) }}"{% if _current_route == 'demo_level' %} aria-current="page"{% endif %}>{{ 'demo.card_level_title'|trans({}, 'messages') }}</a>
            <a class="nowo-ui-link" href="{{ path('demo_conditions', { _locale: _locale }) }}"{% if _current_route == 'demo_conditions' %} aria-current="page"{% endif %}>{{ 'demo.card_conditions_title'|trans({}, 'messages') }}</a>
            <a class="nowo-ui-link" href="{{ path('demo_plain', { _locale: _locale }) }}"{% if _current_route == 'demo_plain' %} aria-current="page"{% endif %}>{{ 'demo.card_plain_title'|trans({}, 'messages') }}</a>
            {% for loc in ['en', 'es'] %}
                <a class="nowo-ui-link" href="{{ path(_locale_route, app.request.attributes.get('_route_params')|default({})|merge({ _locale: loc })) }}"{% if _locale == loc %} aria-current="true"{% endif %}>{{ loc|upper }}</a>
            {% endfor %}
        </nav>
    </header>
{% endblock %}

{% block nowo_ui_content %}
    {% block body %}{% endblock %}
    <p class="nowo-ui-muted">{{ 'demo.footer'|trans({}, 'messages') }}
        <a class="nowo-ui-link" href="https://github.com/nowo-tech/PasswordStrengthBundle" target="_blank" rel="noopener">Password Strength Bundle</a></p>
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% block javascripts %}{% endblock %}
{% endblock %}
