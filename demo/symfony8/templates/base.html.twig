<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ 'demo.title'|trans({}, 'messages') }}{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🔐</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="{{ asset('css/demo.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body class="demo-app d-flex flex-column min-vh-100">
    {% set _locale = app.request.locale|default('en') %}
    {% set _current_route = app.request.attributes.get('_route') ?? 'demo_home' %}
    {% set _locale_route = _current_route == 'demo_root' ? 'demo_home' : _current_route %}

    <nav class="navbar navbar-expand-lg navbar-dark demo-navbar">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="{{ path('demo_home', { _locale: _locale }) }}">
                🔐 {{ 'demo.title'|trans({}, 'messages') }}
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#demoNavbar" aria-controls="demoNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="demoNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link {{ _current_route == 'demo_home' ? 'active' : '' }}" href="{{ path('demo_home', { _locale: _locale }) }}">{{ 'demo.menu_home'|trans({}, 'messages') }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ _current_route == 'demo_level' ? 'active' : '' }}" href="{{ path('demo_level', { _locale: _locale }) }}">{{ 'demo.card_level_title'|trans({}, 'messages') }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ _current_route == 'demo_conditions' ? 'active' : '' }}" href="{{ path('demo_conditions', { _locale: _locale }) }}">{{ 'demo.card_conditions_title'|trans({}, 'messages') }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ _current_route == 'demo_plain' ? 'active' : '' }}" href="{{ path('demo_plain', { _locale: _locale }) }}">{{ 'demo.card_plain_title'|trans({}, 'messages') }}</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="localeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            {{ _locale == 'es' ? 'Español' : 'English' }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="localeDropdown">
                            <li><a class="dropdown-item {{ _locale == 'en' ? 'active' : '' }}" href="{{ path(_locale_route, app.request.attributes.get('_route_params')|default({})|merge({ _locale: 'en' })) }}">English</a></li>
                            <li><a class="dropdown-item {{ _locale == 'es' ? 'active' : '' }}" href="{{ path(_locale_route, app.request.attributes.get('_route_params')|default({})|merge({ _locale: 'es' })) }}">Español</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        {% block body %}{% endblock %}
    </main>

    <footer class="demo-footer py-4 mt-auto">
        <div class="container text-center">
            {{ 'demo.footer'|trans({}, 'messages') }}
            <a href="https://github.com/nowo-tech/PasswordStrengthBundle" target="_blank" rel="noopener">Password Strength Bundle</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
