{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo. The toggle
    stylesheet is the PasswordToggleBundle's own asset. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _locale = app.request.locale|default('en') %}
{% set nowo_ui_demo_platform = {
    bundle: 'Password Strength',
    home_route: 'demo_home',
    home_params: {_locale: _locale},
    repository: 'https://github.com/nowo-tech/PasswordStrengthBundle',
    translation_domain: 'messages',
    locales: ['en', 'es'],
    nav: [
        {label: 'demo.menu_home', route: 'demo_home', params: {_locale: _locale}, section: 'demo.title'},
        {label: 'demo.card_level_title', route: 'demo_level', params: {_locale: _locale}, section: 'demo.title'},
        {label: 'demo.card_conditions_title', route: 'demo_conditions', params: {_locale: _locale}, section: 'demo.title'},
        {label: 'demo.card_plain_title', route: 'demo_plain', params: {_locale: _locale}, section: 'demo.title'},
        {label: 'demo.card_csp_title', route: 'demo_csp', params: {_locale: _locale}, section: 'demo.title'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}{{ 'demo.title'|trans({}, 'messages') }}{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {# PasswordToggleBundle: eye icon show/hide is driven by this stylesheet (without it both icons show). #}
    <link href="{{ asset('/bundles/nowopasswordtoggle/css/toggle_password.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% block javascripts %}{% endblock %}
{% endblock %}
