{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.page_title'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.page_title'|trans({}, 'messages'),
        intro: 'demo.lead'|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    <p>
        <span class="nowo-ui-badge nowo-ui-badge--neutral">{{ 'demo.feature_live'|trans({}, 'messages') }}</span>
        <span class="nowo-ui-badge nowo-ui-badge--neutral">{{ 'demo.feature_validator'|trans({}, 'messages') }}</span>
        <span class="nowo-ui-badge nowo-ui-badge--neutral">{{ 'demo.feature_pattern'|trans({}, 'messages') }}</span>
        <span class="nowo-ui-badge nowo-ui-badge--neutral">{{ 'demo.feature_generator'|trans({}, 'messages') }}</span>
    </p>

    {% set _cards = [
        { route: 'demo_level', key: 'level', badges: [['primary', 'badge_level'], ['neutral', 'badge_toggle'], ['info', 'badge_generator_input']] },
        { route: 'demo_conditions', key: 'conditions', badges: [['primary', 'badge_conditions'], ['warning', 'badge_feedback_above'], ['info', 'badge_generator_modal']] },
        { route: 'demo_plain', key: 'plain', badges: [['neutral', 'badge_plain'], ['success', 'badge_feedback_below']] },
        { route: 'demo_csp', key: 'csp', badges: [['neutral', 'badge_csp'], ['info', 'badge_generator_modal']] },
    ] %}
    <div class="nowo-ui-cards">
        {% for card in _cards %}
            <article class="nowo-ui-card">
                <div class="nowo-ui-card__body">
                    <p>
                        {% for badge in card.badges %}
                            <span class="nowo-ui-badge nowo-ui-badge--{{ badge[0] }}">{{ ('demo.' ~ badge[1])|trans({}, 'messages') }}</span>
                        {% endfor %}
                    </p>
                    <h2 class="nowo-ui-card__title"><a class="nowo-ui-link" href="{{ path(card.route, { _locale: app.request.locale }) }}">{{ ('demo.card_' ~ card.key ~ '_title')|trans({}, 'messages') }}</a></h2>
                    <p class="nowo-ui-muted">{{ ('demo.card_' ~ card.key ~ '_lead')|trans({}, 'messages') }}</p>
                </div>
            </article>
        {% endfor %}
    </div>
{% endblock %}
