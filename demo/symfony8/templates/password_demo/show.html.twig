{% extends 'base.html.twig' %}

{% block title %}{{ page_title_key|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: page_title_key|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    <a class="nowo-ui-back-link" href="{{ path('demo_home', { _locale: app.request.locale }) }}">← {{ 'demo.back_home'|trans({}, 'messages') }}</a>

    <section class="nowo-ui-card" data-testid="demo-case">
        <div class="nowo-ui-card__body">
            <p class="nowo-ui-muted">{{ page_lead_key|trans({}, 'messages')|raw }}</p>
            <p>
                {% for badge_key in badge_keys %}
                    <span class="nowo-ui-badge nowo-ui-badge--neutral">{{ badge_key|trans({}, 'messages') }}</span>
                {% endfor %}
            </p>

            {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
                {# REQ-TWIG-003: child loop #}
                {% for child in form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form) }}

            {% if hint_key is defined and hint_key %}
                <p class="nowo-ui-muted">{{ hint_key|trans({}, 'messages') }}</p>
            {% endif %}
        </div>
    </section>

    <script src="{{ asset('password-strength.js', 'nowo_password_strength') }}" defer></script>
{% endblock %}
