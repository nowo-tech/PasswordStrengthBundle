{
  "_comment": "Shared PHP/TypeScript test vectors (PasswordPatternBuilder / PasswordStrengthEvaluator and password-pattern-builder.ts / password-strength-lib.ts). Each case evaluates \"value\", or the character \"repeat\" repeated \"times\" times.",
  "escape": [
    {
      "input": "!@#$%^&*()_+-=[]{}|;:,.<>?",
      "class": "\\!\\@\\#\\$\\%\\^\\&\\*\\(\\)_\\+\\-\\=\\[\\]\\{\\}\\|\\;\\:\\,\\.\\<\\>\\?",
      "literal": "!@#\\$%\\^&\\*\\(\\)_\\+-=\\[\\]\\{\\}\\|;:,\\.<>\\?"
    },
    {
      "input": "a-b/c\\d",
      "class": "a\\-b\\/c\\\\d",
      "literal": "a-b\\/c\\\\d"
    },
    {
      "input": "&&~~@@",
      "class": "\\&\\&\\~\\~\\@\\@",
      "literal": "&&~~@@"
    }
  ],
  "vectors": [
    {
      "name": "medium",
      "conditions": {
        "min_length": 8,
        "require_lowercase": true,
        "require_uppercase": true,
        "require_digit": true
      },
      "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{8,}$",
      "cases": [
        {
          "value": "Abcdefg1",
          "valid": true,
          "missing": []
        },
        {
          "value": "abcdefgh",
          "valid": false,
          "missing": [
            "require_uppercase",
            "require_digit"
          ]
        },
        {
          "value": "Pa1",
          "valid": false,
          "missing": [
            "min_length"
          ]
        }
      ]
    },
    {
      "name": "default special characters: '-' is literal, not a range",
      "conditions": {
        "require_special": true
      },
      "pattern": "^(?=.*[\\!\\@\\#\\$\\%\\^\\&\\*\\(\\)_\\+\\-\\=\\[\\]\\{\\}\\|\\;\\:\\,\\.\\<\\>\\?]).*$",
      "cases": [
        {
          "value": "abc1",
          "valid": false,
          "missing": [
            "require_special"
          ]
        },
        {
          "value": "abc5",
          "valid": false,
          "missing": [
            "require_special"
          ]
        },
        {
          "value": "abc-",
          "valid": true,
          "missing": []
        },
        {
          "value": "abc_",
          "valid": true,
          "missing": []
        },
        {
          "value": "abc/",
          "valid": false,
          "missing": [
            "require_special"
          ]
        }
      ]
    },
    {
      "name": "special characters '+-='",
      "conditions": {
        "require_special": true,
        "special_chars": "+-="
      },
      "pattern": "^(?=.*[\\+\\-\\=]).*$",
      "cases": [
        {
          "value": "5",
          "valid": false,
          "missing": [
            "require_special"
          ]
        },
        {
          "value": "a-",
          "valid": true,
          "missing": []
        },
        {
          "value": "a=",
          "valid": true,
          "missing": []
        }
      ]
    },
    {
      "name": "special characters '-/'",
      "conditions": {
        "require_special": true,
        "special_chars": "-/"
      },
      "pattern": "^(?=.*[\\-\\/]).*$",
      "cases": [
        {
          "value": "a/b",
          "valid": true,
          "missing": []
        },
        {
          "value": "a-b",
          "valid": true,
          "missing": []
        },
        {
          "value": "a.b",
          "valid": false,
          "missing": [
            "require_special"
          ]
        }
      ]
    },
    {
      "name": "not_contain with '-', '/' and '.'",
      "conditions": {
        "min_length": 3,
        "not_contain": [
          "a-b",
          "x/y",
          "1.2"
        ]
      },
      "pattern": "^(?!.*a-b)(?!.*x\\/y)(?!.*1\\.2).{3,}$",
      "cases": [
        {
          "value": "foo a-b",
          "valid": false,
          "missing": [
            "not_contain"
          ]
        },
        {
          "value": "a_b",
          "valid": true,
          "missing": []
        },
        {
          "value": "zx/y",
          "valid": false,
          "missing": [
            "not_contain"
          ]
        },
        {
          "value": "1x2",
          "valid": true,
          "missing": []
        }
      ]
    },
    {
      "name": "min_unique_chars",
      "conditions": {
        "min_unique_chars": 4
      },
      "pattern": ".*",
      "cases": [
        {
          "value": "aabbcc",
          "valid": false,
          "missing": [
            "min_unique_chars"
          ]
        },
        {
          "value": "abcd",
          "valid": true,
          "missing": []
        }
      ]
    },
    {
      "name": "4096-byte cap",
      "conditions": {
        "min_length": 8
      },
      "pattern": "^.{8,}$",
      "cases": [
        {
          "repeat": "a",
          "times": 4096,
          "valid": true,
          "missing": []
        },
        {
          "repeat": "a",
          "times": 4097,
          "valid": false,
          "missing": [
            "max_length"
          ]
        },
        {
          "repeat": "é",
          "times": 2049,
          "valid": false,
          "missing": [
            "max_length"
          ]
        }
      ]
    }
  ]
}
